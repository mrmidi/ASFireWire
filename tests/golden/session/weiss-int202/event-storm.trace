## StartStreaming
D geometry
H begin
D prepare rate=48000 cap=1[1] play=1[0]
H reserve playback allowed=00000000ffffffff bw=308 -> ch=0
H reserve capture allowed=00000000ffffffff bw=308 -> ch=1
D assign cap=1[1] play=1[0]
H prepare rx ch=1 fmt=0 slots=9 pcm=0
H prepare tx ch=0 sid=0 @s400
D program rx
D program tx+enable
H start tx
H start rx
D confirm
## -> 0x00000000 streaming=1
## RecoverStreaming timing-loss 1
## -> 0x00000000 streaming=1
## RecoverStreaming timing-loss 2
## -> 0x00000000 streaming=1
## RecoverStreaming timing-loss 3
## -> 0x00000000 streaming=1
## QuietPeriod
H stop all
D stop
D geometry
H begin
D prepare rate=48000 cap=1[1] play=1[0]
H reserve playback allowed=00000000ffffffff bw=308 -> ch=0
H reserve capture allowed=00000000ffffffff bw=308 -> ch=1
D assign cap=1[1] play=1[0]
H prepare rx ch=1 fmt=0 slots=9 pcm=0
H prepare tx ch=0 sid=0 @s400
D program rx
D program tx+enable
H start tx
H start rx
D confirm
## -> 0x00000000 streaming=1
