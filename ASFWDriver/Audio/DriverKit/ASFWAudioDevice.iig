//
// ASFWAudioDevice.iig
// ASFWDriver
//
// AudioDevice subclass with StartIO/StopIO overrides for transport lifecycle.
//

#ifndef ASFWAudioDevice_h
#define ASFWAudioDevice_h

#include <DriverKit/DriverKit.iig>
#include <AudioDriverKit/IOUserAudioDevice.iig>

using namespace AudioDriverKit;

class IOUserAudioDriver;
struct ASFWAudioDriver_IVars;

class ASFWAudioDevice : public IOUserAudioDevice
{
public:
    virtual bool init(IOUserAudioDriver* in_driver,
                      bool in_supports_prewarming,
                      OSString* in_device_uid,
                      OSString* in_model_uid,
                      OSString* in_manufacturer_uid,
                      uint32_t in_zero_timestamp_period) override LOCALONLY;

    virtual void free() override LOCALONLY;

    virtual kern_return_t StartIO(IOUserAudioStartStopFlags in_flags) override LOCALONLY;
    virtual kern_return_t StopIO(IOUserAudioStartStopFlags in_flags) override LOCALONLY;

    // CoreAudio sample-rate selection: program the device's DICE clock to the
    // new rate (via the transport-side coordinator) before accepting it.
    virtual kern_return_t HandleChangeSampleRate(double in_sample_rate) override LOCALONLY;

    // Receives a validated app/user-client control intent through the ADK
    // driver action. Geometry changes are committed only inside the following
    // PerformDeviceConfigurationChange window.
    kern_return_t RequestControlConfiguration(uint32_t sampleRateHz,
                                              uint32_t opticalInput,
                                              uint32_t opticalOutput) LOCALONLY;
    // Diagnostic geometry sweep. Rides the same ADK configuration-change window
    // as the control path above -- that window is what stops and restarts IO,
    // which is the whole point -- but on a reserved token, so the rate/optical
    // configuration state machine is never entered or perturbed.
    kern_return_t RequestRuntimeTuning(uint32_t requestId) LOCALONLY;
    virtual kern_return_t PerformDeviceConfigurationChange(uint64_t change_action,
                                                           OSObject* in_change_info) override LOCALONLY;
    virtual kern_return_t AbortDeviceConfigurationChange(uint64_t change_action,
                                                         OSObject* in_change_info) override LOCALONLY;

    void SetDriverIvars(ASFWAudioDriver_IVars* ivars) LOCALONLY;
};

#endif /* ASFWAudioDevice_h */
