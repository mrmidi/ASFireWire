//
// ASFWAudioNub.iig
// ASFWDriver
//
// Audio nub published by ASFWDriver when music subunit is discovered.
// ASFWAudioDriver (IOUserAudioDriver) matches on this nub.
//
// Cross-process communication:
//   ASFWAudioNub forwards RPCs to the GUID-keyed AudioEndpointRuntime. The
//   endpoint runtime owns shared direct audio memory/control state.
//

#ifndef ASFWAudioNub_h
#define ASFWAudioNub_h

#include <DriverKit/IOService.iig>
#include <DriverKit/IOBufferMemoryDescriptor.iig>
#include <DriverKit/IOMemoryDescriptor.iig>
#include <DriverKit/IOMemoryMap.iig>
#include <DriverKit/OSString.iig>
#include <DriverKit/OSArray.iig>
#include <DriverKit/OSDictionary.iig>
#include <DriverKit/OSAction.iig>
#include <atomic>
#include <cstdint>
#include <memory>
namespace ASFW::Audio { struct RateHardwareObservation; }

class ASFWDriver;
// Audio nub that bridges ASFWDriver (hardware) to ASFWAudioDriver (CoreAudio)
// Properties set by ASFWDriver:
//   - ASFWDeviceName (OSString): Device name from config ROM
//   - ASFWChannelCount (OSNumber): Number of audio channels
//   - ASFWSampleRates (OSArray of OSNumber): Supported sample rates
//   - ASFWGUID (OSNumber): Device GUID for identification

class ASFWAudioNub: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;

    virtual kern_return_t CopyDirectAudioMemory(IOMemoryDescriptor** outOutputMemory,
                                                IOMemoryDescriptor** outInputMemory,
                                                IOMemoryDescriptor** outControlMemory,
                                                uint32_t* outOutputFrames,
                                                uint32_t* outOutputChannels,
                                                uint32_t* outInputFrames,
                                                uint32_t* outInputChannels,
                                                uint32_t* outSampleRateHz,
                                                uint64_t* outGeneration);

    // The endpoint's MIDI byte seam, for the audio driver's TX composition: a
    // retained descriptor to map, plus the host -> device geometry (the MPX
    // slot's place in the playback data block). kIOReturnNotReady when the
    // endpoint publishes no MIDI service, which is the ordinary case. The audio
    // driver maps it for the life of one TX run and drops the mapping with the
    // TX slabs; the endpoint keeps the memory alive (retained descriptor).
    virtual kern_return_t CopyMidiTransportMemory(IOMemoryDescriptor** outMemory,
                                                  uint32_t* outDestinationPorts,
                                                  uint32_t* outDestinationSlotIndex,
                                                  uint32_t* outDestinationDbs,
                                                  uint32_t* outDestinationPcmChannels,
                                                  uint32_t* outDbcAligned);

    virtual kern_return_t StartAudioStreaming(uint32_t sampleRateHz);
    virtual kern_return_t StopAudioStreaming();

    /**
     * @brief Allocate memory resources for isochronous audio transmit.
     * Mapped memory is shared between the user-space ADK engine client and the core Dext.
     * @param numSlots The number of packet slots in the payload ring buffer.
     * @param maxPacketBytes Maximum size of a single packet payload in bytes.
     * @param interruptInterval Frequency of interrupts in packets.
     * @param outPayloadSlab Shared memory descriptor containing all packet payloads.
     * @param outMetadataRing Shared memory descriptor containing packet metadata.
     * @param outControlBlock Shared memory descriptor containing stream control states.
     */
    virtual kern_return_t AllocateTxIsochResources(
        uint32_t streamIndex,
        uint32_t numSlots,
        uint32_t maxPacketBytes,
        uint32_t interruptInterval,
        IOMemoryDescriptor** outPayloadSlab,
        IOMemoryDescriptor** outMetadataRing,
        IOMemoryDescriptor** outControlBlock);

    /**
     * @brief Release all allocated transmit isochronous resources.
     */
    virtual kern_return_t FreeTxIsochResources();

    /**
     * @brief Query the current host time and FireWire cycle timer snapshot.
     * Captures a synchronized pair from the hardware for clock seeding.
     * @param outHostTimeMid Monotonic host system time in ticks.
     * @param outCycleTimer Raw FireWire cycle timer value from hardware.
     */
    virtual kern_return_t GetCycleTimePair(uint64_t* outHostTimeMid, uint32_t* outCycleTimer);

    // OSAction-targeted one-way notification: bypasses the nub control queue.
    virtual void TxPreparationReady(OSAction* action TARGET,
                                    uint64_t generation);
    virtual kern_return_t RegisterTxPreparationAction(
        OSAction* action TYPE(TxPreparationReady));
    // Void RPC is one-way: TX preparation must never wait on the nub queue.
    virtual void RequestTimingRecovery(uint64_t rxEpoch);

    virtual void ZtsAnchorReady(OSAction* action TARGET,
                                uint64_t generation);
    virtual kern_return_t RegisterZtsAnchorAction(
        OSAction* action TYPE(ZtsAnchorReady));

    // Device-initiated clock change (front panel / external sync source): the
    // transport side detected the device PLL locked at a rate different from
    // the host's current rate. The audio driver reacts by re-syncing the HAL
    // (forced format change), mirroring AppleUSBAudio's emergency format
    // change for device-driven rate moves.
    virtual void DeviceClockChanged(OSAction* action TARGET,
                                    uint32_t nominalRateHz);
    virtual kern_return_t RegisterDeviceClockChangedAction(
        OSAction* action TYPE(DeviceClockChanged));

    // The transport side must restart the streams while CoreAudio is running
    // them (bus reset, device fault). The audio driver asks the host for a
    // configuration change, so the restart goes StopIO -> StartIO: the only
    // path that rebuilds the audio-owned TX queue and its prefill.
    virtual void IoRestartRequired(OSAction* action TARGET,
                                   uint32_t reason);
    virtual kern_return_t RegisterIoRestartRequiredAction(
        OSAction* action TYPE(IoRestartRequired));

    // Confirmed controls: one-way to the audio driver's Default queue. Never
    // wait on the nub control queue from the controller completion callback.
    virtual void ControlParameterChanged(OSAction* action TARGET,
        uint64_t guid, uint64_t revision, uint64_t sequence,
        uint32_t parameterId, uint64_t kind, uint64_t bits, uint32_t origin);
    virtual kern_return_t RegisterControlChangeAction(
        OSAction* action TYPE(ControlParameterChanged));

    // LOCALONLY methods for ASFWDriver-side access (same process)
    ASFWDriver* GetParentDriver() const LOCALONLY;
    void RecordRemoteDeviceStopResult(kern_return_t status) LOCALONLY;
    kern_return_t StopAudioStreamingOrRemoteResult() LOCALONLY;

    // Fire the registered DeviceClockChanged action (called by the DICE
    // backend when a health probe sees a healthy device at a foreign rate).
    void NotifyDeviceClockChanged(uint32_t nominalRateHz) LOCALONLY;

    // Fire the registered IoRestartRequired action. False when no audio
    // driver is listening, so the caller restarts in place instead.
    bool NotifyIoRestartRequired(uint32_t reason) LOCALONLY;

    // Host-side belief of the device rate (updated on publish and on every
    // successful RequestSampleRateChange). Used by the transport side to
    // detect device-initiated clock moves.
    uint32_t GetCurrentSampleRateHz() const LOCALONLY;

    // Re-read rate and channel counts from the nub's properties. Create()
    // starts the nub before the publisher can set them, so Start alone only
    // ever sees the defaults; the publisher calls this after SetProperties.
    void RefreshFromProperties() LOCALONLY;

    // Set channel count directly (called by AVCDiscovery after Create())
    void SetChannelCount(uint32_t channels) LOCALONLY;
    uint32_t GetChannelCount() const LOCALONLY;
    uint32_t GetInputChannelCount() const LOCALONLY;
    uint32_t GetOutputChannelCount() const LOCALONLY;

    // Stream mode selected during discovery:
    //   0 = non-blocking, 1 = blocking
    void SetStreamMode(uint32_t modeRaw) LOCALONLY;
    uint32_t GetStreamMode() const LOCALONLY;

    // Device identity for protocol bridge routing
    void SetGuid(uint64_t guid) LOCALONLY;
    uint64_t GetGuid() const LOCALONLY;

    // Request a device sample-rate change (CoreAudio HandleChangeSampleRate ->
    // DICE CLOCK_SELECT + duplex reconfigure). This is IIG dispatch between two
    // IOService objects on different dispatch queues, NOT a process boundary:
    // both personalities share one IOUserServerName with IOUserServerOneProcess
    // (Info.plist:35-38, :99-102), as line 111 above already states. The
    // dispatch is what makes the parent -> ServiceContext -> AudioCoordinator
    // chain valid. Returns kIOReturnUnsupported for a rate the device does not
    // advertise.
    virtual kern_return_t RequestSampleRateChange(uint32_t sampleRateHz);
    // Read a settled DICE formation before requesting the host window. Only
    // candidate metadata changes; the committed rate and buffers stay intact.
    virtual kern_return_t CopyObservedRateCatalog(uint32_t sampleRateHz,
        OSDictionary** outProperties);
    // Configuration-window calls only. The observation is read-only and
    // generation/incarnation bound; no cached rate is returned as evidence.
    virtual kern_return_t ReadRateClockState(uint64_t* outIncarnation,
        uint64_t* outRouteEpoch, uint32_t* outBusGeneration,
        uint32_t* outOutputRateHz, uint32_t* outInputRateHz);
    virtual kern_return_t ApplyRate(uint32_t sampleRateHz, uint64_t expectedIncarnation,
        uint64_t expectedRouteEpoch, uint32_t expectedBusGeneration);
    virtual kern_return_t InstallRateFormation(uint32_t sampleRateHz,
        uint64_t expectedIncarnation, uint64_t expectedRouteEpoch,
        uint32_t expectedBusGeneration);

    virtual kern_return_t CopyParameterControls(OSDictionary** properties);
    virtual kern_return_t SetControlParameter(uint32_t parameterId, uint64_t kind, uint64_t bits,
        uint64_t* confirmedKind, uint64_t* confirmedBits);
    virtual kern_return_t ReadControlParameter(uint32_t parameterId, bool normalized,
        uint64_t* kind, uint64_t* bits);

};

struct ASFWAudioNub_IVars {
    std::atomic<uint64_t> remoteStopResult{0};
    IOService* parentDriver;              // ASFWDriver instance (not retained, provider lifetime)

    // Audio channel counts (read from ASFWDriver properties; may be refined from protocol runtime caps)
    uint64_t guid{0};
    uint32_t channelCount{2};
    uint32_t inputChannelCount{2};       // Host capture channels (device->host PCM)
    uint32_t outputChannelCount{2};      // Host playback channels (host->device PCM)
    uint32_t currentSampleRateHz{48000};
    bool rateObservationValid{false};
    std::shared_ptr<ASFW::Audio::RateHardwareObservation> rateHardwareObservation;
    uint64_t rateObservedIncarnation{0};
    uint64_t rateObservedRouteEpoch{0};
    uint32_t rateObservedGeneration{0};
    uint32_t rateObservedInputRate{0};
    uint32_t rateObservedOutputRate{0};
    uint32_t streamModeRaw{0};             // 0=non-blocking, 1=blocking
    OSAction* txPreparationAction{nullptr};
    OSAction* ztsAnchorAction{nullptr};
    OSAction* deviceClockChangedAction{nullptr};
    OSAction* ioRestartRequiredAction{nullptr};
    OSAction* controlChangeAction{nullptr};
};

#endif /* ASFWAudioNub_h */
