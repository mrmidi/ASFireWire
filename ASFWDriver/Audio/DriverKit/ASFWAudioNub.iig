//
// ASFWAudioNub.iig
// ASFWDriver
//
// Audio nub published by ASFWDriver when music subunit is discovered.
// ASFWAudioDriver (IOUserAudioDriver) matches on this nub.
//
// Cross-process communication:
//   ASFWAudioNub forwards RPCs to the endpoint-keyed AudioEndpointRuntime. The
//   endpoint runtime owns shared direct audio memory/control state.
//

#ifndef ASFWAudioNub_h
#define ASFWAudioNub_h

#include <DriverKit/IOService.iig>
#include <DriverKit/IOBufferMemoryDescriptor.iig>
#include <DriverKit/IOMemoryDescriptor.iig>
#include <DriverKit/IOMemoryMap.iig>
#include <DriverKit/OSString.iig>
#include <DriverKit/OSArray.iig>
#include <DriverKit/OSAction.iig>
#include <atomic>
#include <cstdint>

class ASFWDriver;
namespace ASFW::Audio::Shared { struct AudioRuntimeTuning; struct RuntimeTuningSnapshot; struct RuntimeTuningStore; }
// Audio nub that bridges ASFWDriver (hardware) to ASFWAudioDriver (CoreAudio)
// Properties set by ASFWDriver:
//   - ASFWDeviceName (OSString): Device name from config ROM
//   - ASFWChannelCount (OSNumber): Number of audio channels
//   - ASFWSampleRates (OSArray of OSNumber): Supported sample rates
//   - ASFWAudioEndpointProfileV1 (OSData): immutable bounded numeric profile
//   - ASFWAudioEndpointID (OSNumber): runtime routing identity

class ASFWAudioNub: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;

    virtual kern_return_t CopyDirectAudioMemory(IOMemoryDescriptor** outOutputMemory,
                                                IOMemoryDescriptor** outInputMemory,
                                                IOMemoryDescriptor** outControlMemory,
                                                uint32_t* outOutputFrames,
                                                uint32_t* outOutputChannels,
                                                uint32_t* outInputFrames,
                                                uint32_t* outInputChannels,
                                                uint32_t* outSampleRateHz,
                                                uint64_t* outGeneration);

    virtual kern_return_t StartAudioStreaming();
    virtual kern_return_t StopAudioStreaming();

    /**
     * @brief Allocate memory resources for isochronous audio transmit.
     * Mapped memory is shared between the user-space ADK engine client and the core Dext.
     * @param numSlots The number of packet slots in the payload ring buffer.
     * @param maxPacketBytes Maximum size of a single packet payload in bytes.
     * @param interruptInterval Frequency of interrupts in packets.
     * @param outPayloadSlab Shared memory descriptor containing all packet payloads.
     * @param outMetadataRing Shared memory descriptor containing packet metadata.
     * @param outControlBlock Shared memory descriptor containing stream control states.
     */
    virtual kern_return_t AllocateTxIsochResources(
        uint32_t streamIndex,
        uint32_t numSlots,
        uint32_t maxPacketBytes,
        uint32_t interruptInterval,
        IOMemoryDescriptor** outPayloadSlab,
        IOMemoryDescriptor** outMetadataRing,
        IOMemoryDescriptor** outControlBlock);

    /**
     * @brief Release all allocated transmit isochronous resources.
     */
    virtual kern_return_t FreeTxIsochResources();

    /**
     * @brief Hand the MIDI byte seam to the audio service for TX composition.
     *
     * The descriptor belongs to ASFWMidiNub; this nub only relays it, because
     * the TX content pump currently lives in ASFWAudioDriver. When WP-6 extracts
     * that pump into a shared session owned by the core driver, this relay and
     * the audio service's mapping go away -- the session will hold the mapping
     * directly. Until then the audio service is the host -> device consumer and
     * needs it.
     *
     * Geometry travels with the memory so the caller cannot pair a block with a
     * slot index from a different formation.
     */
    virtual kern_return_t CopyMidiTransportMemory(IOMemoryDescriptor** outMemory,
                                                  uint64_t* outStreamEpoch,
                                                  uint32_t* outSlotIndex,
                                                  uint32_t* outDbs,
                                                  uint32_t* outPortCount,
                                                  uint32_t* outDbcAligned);

    /// Core-driver side: publish the seam this endpoint's MIDI rides.
    /// Passing nullptr clears it.
    void SetMidiTransportSource(IOMemoryDescriptor* memory,
                                uint64_t streamEpoch, uint32_t slotIndex,
                                uint32_t dbs, uint32_t portCount,
                                uint32_t dbcAligned) LOCALONLY;

    /**
     * @brief Producer-to-transport doorbell for published late payload offers.
     *
     * The content side writes a replacement payload image into shared memory
     * and offers it; only transport may bind it to a descriptor. Without this
     * call the offer waits for the next completion interrupt, and by then the
     * hardware has moved on by a whole completion group while the offer window
     * is only kPayloadFinalityLeadPackets wide -- so replacements published in
     * between are accepted and then discarded.
     *
     * Call once per batch of offers, never per packet; IsochTxQueueControl
     * coalesces, so a caller that finds a notification outstanding skips this.
     *
     * Payload-opaque: transport learns that replacements exist, never what
     * they contain.
     *
     * @param streamIndex Transmit stream, matching AllocateTxIsochResources.
     */
    virtual kern_return_t ServiceLatePayloadOffers(uint32_t streamIndex);

    /**
     * @brief Query the current host time and FireWire cycle timer snapshot.
     * Captures a synchronized pair from the hardware for clock seeding.
     * @param outHostTimeMid Monotonic host system time in ticks.
     * @param outCycleTimer Raw FireWire cycle timer value from hardware.
     */
    virtual kern_return_t GetCycleTimePair(uint64_t* outHostTimeMid, uint32_t* outCycleTimer);

    /**
     * @brief Query the authoritative topology revision from the endpoint runtime.
     * @param outTopologyRevision Pointer to receive the revision.
     */
    virtual kern_return_t GetTopologyRevision(uint64_t* outTopologyRevision);

    virtual void TxPreparationReady(OSAction* action TARGET,
                                    uint64_t generation);
    virtual kern_return_t RegisterTxPreparationAction(
        OSAction* action TYPE(TxPreparationReady));
    // Audio-owned write-frontier request. It reuses the registered action so
    // packet preparation is dispatched on ASFWAudioDriver's TxPreparation
    // queue rather than on the CoreAudio real-time callback.
    virtual kern_return_t RequestTxPreparation(uint64_t generation);

    // Terminal TX transport fault. The core side raises this on the isoch
    // watchdog/poll thread; the action moves it to ASFWAudioDriver's default
    // queue so the blocking recovery never runs on the thread that also
    // carries the RX drain.
    virtual void TxTransportFaultReady(OSAction* action TARGET,
                                       uint32_t statusRaw,
                                       uint64_t streamGeneration);
    virtual kern_return_t RegisterTxTransportFaultAction(
        OSAction* action TYPE(TxTransportFaultReady));
    // Called back from ASFWAudioDriver's queue once the hop has landed.
    virtual kern_return_t RecoverAudioStreamingAfterTxFault();

    virtual void ZtsAnchorReady(OSAction* action TARGET,
                                uint64_t generation);
    virtual kern_return_t RegisterZtsAnchorAction(
        OSAction* action TYPE(ZtsAnchorReady));

    // Device-initiated clock change (front panel / external sync source): the
    // transport side detected the device PLL locked at a rate different from
    // the host's current rate. The audio driver reacts by re-syncing the HAL
    // (forced format change), mirroring AppleUSBAudio's emergency format
    // change for device-driven rate moves.
    virtual void DeviceClockChanged(OSAction* action TARGET,
                                    uint32_t nominalRateHz);
    virtual kern_return_t RegisterDeviceClockChangedAction(
        OSAction* action TYPE(DeviceClockChanged));

    // Core control-plane request -> ADK service. Optical values are 1 = ADAT
    // and 2 = S/PDIF. The action only carries bounded scalar intent; ADK owns
    // the token and requests its configuration-change window itself.
    virtual void DeviceConfigurationRequested(OSAction* action TARGET,
                                              uint32_t sampleRateHz,
                                              uint32_t opticalInput,
                                              uint32_t opticalOutput);
    virtual kern_return_t RegisterDeviceConfigurationRequestedAction(
        OSAction* action TYPE(DeviceConfigurationRequested));

    // LOCALONLY methods for ASFWDriver-side access (same process)
    ASFWDriver* GetParentDriver() const LOCALONLY;

    // Fire the registered DeviceClockChanged action (called by the DICE
    // backend when a health probe sees a healthy device at a foreign rate).
    void NotifyDeviceClockChanged(uint32_t nominalRateHz) LOCALONLY;
    [[nodiscard]] bool NotifyDeviceConfigurationRequested(
        uint32_t sampleRateHz, uint32_t opticalInput, uint32_t opticalOutput) LOCALONLY;
    void RegisterTxLatencySession(void* session) LOCALONLY;
    void UnregisterTxLatencySession(void* session) LOCALONLY;

    // Request IDs bind each callback to one locked transaction.
    virtual void RuntimeTuningRequested(OSAction* action TARGET, uint32_t requestId);
    virtual kern_return_t RegisterRuntimeTuningRequestedAction(
        OSAction* action TYPE(RuntimeTuningRequested));
    kern_return_t NotifyRuntimeTuningRequested(
        const ASFW::Audio::Shared::AudioRuntimeTuning& candidate, uint32_t groups) LOCALONLY;
    bool BeginRuntimeTuningWindow(uint32_t requestId) LOCALONLY;
    bool CommitRuntimeTuning(uint32_t requestId,
        ASFW::Audio::Shared::AudioRuntimeTuning& active) LOCALONLY;
    void CompleteRuntimeTuning(uint32_t requestId, uint32_t error, bool aborted) LOCALONLY;
    void PublishRuntimeTuningGraph(const ASFW::Audio::Shared::AudioRuntimeTuning& active,
        uint32_t rate, uint32_t inputs, uint32_t outputs) LOCALONLY;
    bool CopyRuntimeTuningSnapshot(ASFW::Audio::Shared::RuntimeTuningSnapshot& out) const LOCALONLY;
    uint32_t CurrentRuntimeTuningWindow() const LOCALONLY;
    void SetAudioIoRunning(bool running, uint32_t rate) LOCALONLY;

    // Host-side belief of the device rate, updated only after a successful
    // semantic configuration projection. Used by the transport side to detect
    // device-initiated clock moves.
    uint32_t GetCurrentSampleRateHz() const LOCALONLY;

    // Set scalar geometry directly before publication. No profile pointer may
    // cross the service boundary.
    void SetChannelCount(uint32_t channels) LOCALONLY;
    void SetAudioGeometry(uint32_t inputChannels,
                          uint32_t outputChannels,
                          uint32_t sampleRateHz,
                          uint32_t streamModeRaw) LOCALONLY;
    uint32_t GetChannelCount() const LOCALONLY;
    uint32_t GetInputChannelCount() const LOCALONLY;
    uint32_t GetOutputChannelCount() const LOCALONLY;

    // Stream mode selected during discovery:
    //   0 = non-blocking, 1 = blocking
    void SetStreamMode(uint32_t modeRaw) LOCALONLY;
    uint32_t GetStreamMode() const LOCALONLY;

    // Runtime endpoint identity for service routing. This is never a persistent
    // CoreAudio UID and is unrelated to the observed Config-ROM EUI-64.
    void SetEndpointId(uint64_t endpointId) LOCALONLY;
    uint64_t GetEndpointId() const LOCALONLY;

    // Apply a fully semantic hardware configuration. Optical values are
    // numeric wire values: 1 = ADAT, 2 = S/PDIF. The call crosses the service
    // queue only; it never transports pointers or ADK objects. A successful
    // result is hardware-confirmed driver belief, not yet a CoreAudio commit.
    virtual kern_return_t ApplyDeviceConfiguration(
        uint32_t sampleRateHz,
        uint32_t opticalInput,
        uint32_t opticalOutput,
        uint32_t* outInputChannels,
        uint32_t* outOutputChannels);

    // Make the already-projected configuration active in the core runtime.
    // This is called only after the AudioDriverKit mutation has succeeded.
    virtual kern_return_t CommitDeviceConfiguration(
        uint32_t sampleRateHz,
        uint32_t opticalInput,
        uint32_t opticalOutput);

    // Protocol-backed boolean control bridge. Same process as above - this
    // crosses dispatch queues, not processes. No device currently answers these:
    // the phantom/polarity path they served was removed with the CoreAudio
    // control policy decision (FW-132), so IDeviceProtocol's defaults report
    // kIOReturnUnsupported. Phantom and polarity move to the ASFW app over the
    // user client instead.
    virtual kern_return_t GetProtocolBooleanControl(
        uint32_t classIdFourCC,
        uint32_t element,
        bool* outValue);

    virtual kern_return_t SetProtocolBooleanControl(
        uint32_t classIdFourCC,
        uint32_t element,
        bool value);
};

struct ASFWAudioNub_IVars {
    IOService* parentDriver;              // ASFWDriver instance (not retained, provider lifetime)

    // Audio channel counts (read from ASFWDriver properties; may be refined from protocol runtime caps)
    uint64_t endpointId{0};
    uint32_t channelCount{2};
    uint32_t inputChannelCount{2};       // Host capture channels (device->host PCM)
    uint32_t outputChannelCount{2};      // Host playback channels (host->device PCM)
    uint32_t currentSampleRateHz{48000};
    uint32_t streamModeRaw{0};             // 0=non-blocking, 1=blocking
    OSAction* txPreparationAction{nullptr};
    OSAction* txTransportFaultAction{nullptr};
    OSAction* ztsAnchorAction{nullptr};
    OSAction* deviceClockChangedAction{nullptr};
    OSAction* deviceConfigurationRequestedAction{nullptr};
    OSAction* runtimeTuningRequestedAction{nullptr};

    ASFW::Audio::Shared::RuntimeTuningStore* tuningStore{nullptr};

    // MIDI byte seam relayed from ASFWMidiNub, which owns the descriptor. Held
    // retained here so the audio service can map it; cleared on teardown before
    // the MIDI nub goes away. Relocated to the shared session by WP-6.
    IOMemoryDescriptor* midiTransportMemory{nullptr};  // retained
    uint64_t midiStreamEpoch{0};
    uint32_t midiSlotIndex{0};
    uint32_t midiDbs{0};
    uint32_t midiPortCount{0};
    uint32_t midiDbcAligned{1};
};

#endif /* ASFWAudioNub_h */
