//
// ASFWAudioDriver.iig
// ASFWDriver
//
// AudioDriverKit driver that matches on ASFWAudioNub.
// Creates IOUserAudioDevice when started.
//

#ifndef ASFWAudioDriver_h
#define ASFWAudioDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <DriverKit/OSAction.iig>
#include <AudioDriverKit/IOUserAudioDriver.iig>

using namespace AudioDriverKit;

#include "ASFWAudioNub.iig"

class ASFWAudioDriver: public IOUserAudioDriver
{
public:
    virtual bool init() override;
    virtual void free() override;
    
    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;
    
    virtual kern_return_t NewUserClient(uint32_t in_type,
                                        IOUserClient** out_user_client) override;
    
    virtual kern_return_t StartDevice(IOUserAudioObjectID in_object_id,
                                      IOUserAudioStartStopFlags in_flags) override;
    
    virtual kern_return_t StopDevice(IOUserAudioObjectID in_object_id,
                                     IOUserAudioStartStopFlags in_flags) override;

    virtual void TxPreparationReady(OSAction* action,
                                    uint64_t generation)
        TYPE(ASFWAudioNub::TxPreparationReady)
        QUEUENAME(TxPreparation);

    virtual void ZtsAnchorReady(OSAction* action,
                                uint64_t generation)
        TYPE(ASFWAudioNub::ZtsAnchorReady)
        QUEUENAME(Zts);

    // Deliberately on the default queue, not TxPreparation: the handler blocks
    // in RecoverStreaming(), and the TxPreparation queue must stay free to
    // drain. Mirrors DeviceConfigurationRequested, the other blocking action.
    virtual void TxTransportFaultReady(OSAction* action,
                                       uint32_t statusRaw,
                                       uint64_t streamGeneration)
        TYPE(ASFWAudioNub::TxTransportFaultReady);

    virtual void DeviceConfigurationRequested(
        OSAction* action, uint32_t sampleRateHz, uint32_t opticalInput,
        uint32_t opticalOutput)
        TYPE(ASFWAudioNub::DeviceConfigurationRequested);

    // Diagnostic geometry sweep. Default queue for the same reason as the
    // configuration bridge: applying blocks on a configuration-change window.
    // The candidate itself is read back from the nub; only the group mask
    // travels with the action.
    virtual void RuntimeTuningRequested(OSAction* action, uint32_t groups)
        TYPE(ASFWAudioNub::RuntimeTuningRequested);

    // Protocol-backed boolean control bridge (used by custom control subclass).
    kern_return_t ApplyProtocolBooleanControl(uint32_t classIdFourCC,
                                              uint32_t element,
                                              bool value) LOCALONLY;
    kern_return_t ReadProtocolBooleanControl(uint32_t classIdFourCC,
                                             uint32_t element,
                                             bool* outValue) LOCALONLY;
};

#endif /* ASFWAudioDriver_h */
