//
// ASFWAudioDriver.iig
// ASFWDriver
//
// AudioDriverKit driver that matches on ASFWAudioNub.
// Creates IOUserAudioDevice when started.
//

#ifndef ASFWAudioDriver_h
#define ASFWAudioDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <DriverKit/OSAction.iig>
#include <AudioDriverKit/IOUserAudioDriver.iig>

using namespace AudioDriverKit;

#include "ASFWAudioNub.iig"

class ASFWAudioDriver: public IOUserAudioDriver
{
public:
    virtual bool init() override;
    virtual void free() override;
    
    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;
    
    virtual kern_return_t NewUserClient(uint32_t in_type,
                                        IOUserClient** out_user_client) override;
    
    virtual kern_return_t StartDevice(IOUserAudioObjectID in_object_id,
                                      IOUserAudioStartStopFlags in_flags) override;
    
    virtual kern_return_t StopDevice(IOUserAudioObjectID in_object_id,
                                     IOUserAudioStartStopFlags in_flags) override;

    virtual void TxPreparationReady(OSAction* action,
                                    uint64_t generation)
        TYPE(ASFWAudioNub::TxPreparationReady)
        QUEUENAME(TxPreparation);

    virtual void ZtsAnchorReady(OSAction* action,
                                uint64_t generation)
        TYPE(ASFWAudioNub::ZtsAnchorReady)
        QUEUENAME(Zts);

    // Device-initiated clock change (front panel / external sync): re-sync
    // the HAL to the device's new rate via a forced configuration change.
    virtual void DeviceClockChanged(OSAction* action,
                                    uint32_t nominalRateHz)
        TYPE(ASFWAudioNub::DeviceClockChanged);

    // Protocol-backed boolean control bridge (used by custom control subclass).
    kern_return_t ApplyProtocolBooleanControl(uint32_t classIdFourCC,
                                              uint32_t element,
                                              bool value) LOCALONLY;
    kern_return_t ReadProtocolBooleanControl(uint32_t classIdFourCC,
                                             uint32_t element,
                                             bool* outValue) LOCALONLY;

    // Protocol-backed level control bridge (used by ASFWProtocolLevelControl). dB values.
    kern_return_t DescribeProtocolLevelControl(uint32_t classIdFourCC,
                                               uint32_t scopeFourCC,
                                               uint32_t element,
                                               bool* outSettable,
                                               float* outMinDecibels,
                                               float* outMaxDecibels) LOCALONLY;
    kern_return_t ReadProtocolLevelControl(uint32_t classIdFourCC,
                                           uint32_t scopeFourCC,
                                           uint32_t element,
                                           float* outDecibels) LOCALONLY;
    kern_return_t ApplyProtocolLevelControl(uint32_t classIdFourCC,
                                            uint32_t scopeFourCC,
                                            uint32_t element,
                                            float decibels) LOCALONLY;

    // Moves the output volume control to follow the device's own knob while it streams
    // (ASFWAudioDriverControls.cpp). Runs on the default queue.
    virtual void ControlSyncTimerFired(OSAction* action,
                                       uint64_t time)
        TYPE(IOTimerDispatchSource::TimerOccurred);

    void ArmControlSyncTimer() LOCALONLY;

    // Output mute standing in for hardware that has none: writes the minimum level, and
    // on unmute the level the volume control holds (Runtime/OutputMutePolicy.hpp).
    kern_return_t ApplyOutputMute(bool muted) LOCALONLY;
};

#endif /* ASFWAudioDriver_h */
