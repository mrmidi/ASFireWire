//
// ASFWMIDIDriver.iig
// ASFWDriver
//
// The MIDI half of ASFW, as its own IOService.
//
// IOUserAudioDriver and IOUserMIDIDriver are both direct IOService subclasses,
// so one class cannot be both; MIDI gets its own service and its own
// personality. It matches ASFWMidiNub on ASFWNubType == "MIDI", exactly as
// ASFWAudioDriver matches ASFWAudioNub on "Audio".
//
// Everything this service needs about its endpoint arrives as registry
// properties on the nub (Midi/Core/MidiNubProperties.hpp), set before the nub
// started.
//

#ifndef ASFWMIDIDriver_h
#define ASFWMIDIDriver_h

#include <DriverKit/IOService.iig>
#include <MIDIDriverKit/IOUserMIDIDriver.iig>

using namespace MIDIDriverKit;

class ASFWMIDIDriver: public IOUserMIDIDriver
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;

    virtual kern_return_t NewUserClient(uint32_t type,
                                        IOUserClient** userClient) override;

    virtual kern_return_t StartIO(OSArray* deviceList) override;
    virtual kern_return_t StopIO() override;
};

#endif /* ASFWMIDIDriver_h */
